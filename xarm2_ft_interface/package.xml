<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm2_ft_interface</name>
  <version>0.1.0</version>
  <description>
    A ros2_control SensorInterface that subscribes to a geometry_msgs/WrenchStamped
    topic and exposes force/torque values as hardware state interfaces.
    Used for real xArm FT hardware. Simulation uses native Gazebo FT interfaces.
  </description>
  <maintainer email="info@hivebotics.com">Hivebotics</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>geometry_msgs</depend>
  <depend>realtime_tools</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
